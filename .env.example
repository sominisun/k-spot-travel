# --- Site ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# --- AI chatbot (optional — keyword-search fallback works without it) -------
ANTHROPIC_API_KEY=

# --- Community (Discord) -----------------------------------------------------
NEXT_PUBLIC_DISCORD_INVITE=https://discord.gg/your-invite
# Operator inbox: every unanswered/negative chat turn is posted here
DISCORD_WEBHOOK_URL=

# --- Payments (Lemon Squeezy; demo mode until BOTH keys below are set) -------
# Checkout URLs (buttons link here):
NEXT_PUBLIC_LS_PASS_URL=
NEXT_PUBLIC_LS_INSIDER_URL=
# Route Pass gate: enforced only when LEMONSQUEEZY_API_KEY *and* PASS_SECRET
# are both set. LS_API_KEY validates the buyer's license key; PASS_SECRET
# (any long random string) signs the stateless pass token — keep it secret.
LEMONSQUEEZY_API_KEY=
# Product id of the Insider subscription (distinguishes it from Route Pass keys)
LEMONSQUEEZY_INSIDER_PRODUCT_ID=
PASS_SECRET=

# --- Email delivery of Route Pass PDFs (Resend; downloads locally without) ---
RESEND_API_KEY=
RESEND_FROM=K-SPOT Travel <pass@your-domain.com>
# Newsletter audience (Resend > Audiences > copy the ID). Without it,
# signups queue to .chatlog/newsletter.jsonl + the Discord inbox.
RESEND_AUDIENCE_ID=
# Where contact-form messages and signup alerts are emailed. On Resends free
# tier (no domain yet) this MUST be the email of the Resend account itself.
CONTACT_FORWARD_EMAIL=

# --- Google AdSense (ads stay hidden until set) -------------------------------
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE=
NEXT_PUBLIC_ADSENSE_SLOT_LIST=

# --- Affiliate tracking (links stay plain until each program is approved) -----
# Paste the tracking query string your affiliate dashboard gives you, e.g.
# NEXT_PUBLIC_AFF_KLOOK="aid=12345&aff_adid=67890"
NEXT_PUBLIC_AFF_KLOOK=
NEXT_PUBLIC_AFF_TRAZY=
NEXT_PUBLIC_AFF_OLIVEYOUNG=
NEXT_PUBLIC_AFF_STYLEKOREAN=
NEXT_PUBLIC_AFF_YESSTYLE=
NEXT_PUBLIC_AFF_AGODA=
